generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MojangProfileCache {
  uuid        String    @id @unique
  name        String
  profileData Json
  cachedAt    DateTime  @default(now())
  expiresAt   DateTime?
}

model LeaderboardCache {
  id        String   @id @default("leaderboard")
  data      Json
  updatedAt DateTime @default(now()) @updatedAt
}
